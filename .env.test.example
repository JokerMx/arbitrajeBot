# Variables para docker-compose.test.yml (modo papel, sin dinero real).
# Copia a .env.test y completa. .env.test no se sube a git.

NETWORK=mainnet
RUST_LOG=info
INITIAL_CAPITAL=50

# Clave desechable SIN fondos (en papel no se firman órdenes). Genera una con:
#   python -c "import secrets;print('0x'+secrets.token_hex(32))"
PRIVATE_KEY=
WALLET=

STRATEGY_MODE=trend
TREND_SYMBOLS=BTC,ETH,SOL,HYPE,XRP,SUI,ENA,NEAR,ZEC,WLD
TREND_RISK_PER_TRADE=0.005
TREND_MAX_POSITIONS=4
TREND_MAX_LEVERAGE=3
# Para ver entradas rápido en la prueba usa un canal corto (lo normal es 168)
# TREND_BREAKOUT_HOURS=24
# TREND_EXIT_HOURS=6

ADMIN_API_TOKEN=test-local

# Bot de Telegram de PRUEBA (créalo con @BotFather; no uses el de producción,
# o tus usuarios reales recibirían las señales de prueba)
TELEGRAM_BOT_TOKEN=
# Tu chat id (escríbele a @userinfobot); quedarás como administrador
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_ORDERS=true
TELEGRAM_NOTIFY_FILLS=true
TELEGRAM_NOTIFY_STATUS=false

# Precio mínimo para probar pagos reales con Stars sin gastar casi nada
PREMIUM_PRICE_STARS=1
PREMIUM_DAYS=30
TRIAL_DAYS=3
REFERRAL_BONUS_DAYS=7
# Retraso corto para ver la liberación de señales a Free en la prueba
FREE_SIGNAL_DELAY_HOURS=1
TELEGRAM_AUTO_AUTHORIZE=true
PAYSUPPORT_CONTACT=@tu_usuario
