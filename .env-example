# =============================================
# HYPERLIQUID TRADING BOT + SEÑALES PREMIUM
# =============================================

# =============================================
# CONFIGURACIÓN GENERAL DEL BOT
# =============================================

# Red: mainnet (REAL - con dinero real)
NETWORK=mainnet

# Nivel de logging: info (puedes usar debug para monitorear)
LOG_LEVEL=info

# Clave privada de la wallet (idealmente una API wallet de Hyperliquid, sin permiso de retiro)
# ⚠️ PROTEGE ESTA CLAVE - NUNCA LA COMPARTAS
PRIVATE_KEY=

# Dirección de la wallet
WALLET=

# =============================================
# TIPO DE EXCHANGE
# =============================================
# Cambiar a hyperliquid_mainnet para operar REAL
EXCHANGE_TYPE=simulated

# =============================================
# CAPITAL INICIAL (USDC real)
# =============================================
INITIAL_CAPITAL=50.00

# =============================================
# ESTRATEGIA (MÁS CONSERVADORA PARA PRODUCCIÓN)
# =============================================

# Spread base en ticks - más conservador (8-10 ticks)
STRATEGY_BASE_SPREAD_TICKS=10

# Aversión al riesgo - más conservadora
STRATEGY_RISK_AVERSION=0.15

# Impacto de mercado
STRATEGY_MARKET_IMPACT=0.01

# Fuerza del skew por inventario
STRATEGY_INVENTORY_SKEW_STRENGTH=0.15

# Ventana de tiempo para cálculo de volatilidad (minutos)
STRATEGY_VOLATILITY_LOOKBACK_MINUTES=20

# Tiempo de refresco de órdenes (milisegundos)
STRATEGY_ORDER_REFRESH_MS=30000

# Ratio máximo de inventario
STRATEGY_MAX_INVENTORY_RATIO=0.10

# =============================================
# GESTIÓN DE RIESGO (MUY CONSERVADORA)
# =============================================

# Máximo tamaño de posición: 10% del capital (max $1 USDC)
RISK_MAX_POSITION_SIZE_PCT=0.10

# Máxima pérdida diaria: 20% del capital ($2 USDC)
RISK_MAX_DAILY_LOSS_PCT=0.20

# Drawdown máximo: 15%
RISK_MAX_DRAWDOWN_PCT=0.15

# Activar kill switch automático
RISK_KILL_SWITCH_ENABLED=true

# Circuit breaker: 3% movimiento en 1 minuto
RISK_CIRCUIT_BREAKER_THRESHOLD=0.03

# =============================================
# CONFIGURACIÓN DE MERCADOS (solo BTC para empezar)
# =============================================

# BTC - Solo un mercado para reducir riesgo
MARKETS_ENABLED_BTC=true
MARKETS_MARGIN_ALLOC_BTC=0.10
MARKETS_MIN_SIZE_BTC=0.00001

# ETH - Desactivado inicialmente
MARKETS_ENABLED_ETH=false
MARKETS_MARGIN_ALLOC_ETH=0.10
MARKETS_MIN_SIZE_ETH=0.0001

# BNB - Desactivado
MARKETS_ENABLED_BNB=false
MARKETS_MARGIN_ALLOC_BNB=0.10
MARKETS_MIN_SIZE_BNB=0.001

# SOL - Desactivado
MARKETS_ENABLED_SOL=false
MARKETS_MARGIN_ALLOC_SOL=0.10
MARKETS_MIN_SIZE_SOL=0.01

# XRP - Desactivado
MARKETS_ENABLED_XRP=false
MARKETS_MARGIN_ALLOC_XRP=0.10
MARKETS_MIN_SIZE_XRP=0.5

# =============================================
# NOTIFICACIONES TELEGRAM (ACTIVADAS)
# =============================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_ORDERS=true
TELEGRAM_NOTIFY_FILLS=true
TELEGRAM_NOTIFY_STATUS=true

# =============================================
# BASE DE DATOS
# =============================================
DATABASE_URL=mysql://USUARIO:CLAVE@127.0.0.1:3306/NOMBRE_BD
DB_TABLE_PREFIX=BOT_

# =============================================
# DASHBOARD
# =============================================
API_PORT=3001
DASHBOARD_PORT=5173
DASHBOARD_MODE=embedded
VITE_BACKEND_PROTOCOL=http
VITE_BACKEND_HOST=localhost
VITE_BACKEND_PORT=3001

# =============================================
# ESTRATEGIA ACTIVA
# =============================================
# trend (seguimiento de tendencia 1h, recomendado) | market_making
# Con EXCHANGE_TYPE distinto de hyperliquid_mainnet, trend opera en PAPEL (sin órdenes)
STRATEGY_MODE=trend

# Monedas (si se omite, usa los mercados habilitados en el dashboard)
TREND_SYMBOLS=BTC,ETH,SOL,HYPE,XRP,SUI,ENA,NEAR,ZEC,WLD
# Riesgo por operación (0.005 = 0.5%). Límite duro: 2%. Recomendado en marcha blanca: 0.005
TREND_RISK_PER_TRADE=0.005
TREND_MAX_POSITIONS=4
# Nocional total / equity (límite duro: 5)
TREND_MAX_LEVERAGE=3

# =============================================
# SEGURIDAD DE LA API / DASHBOARD
# =============================================
# Token obligatorio para producción (el dashboard lo pide una vez). Genera uno con:
#   openssl rand -hex 32
ADMIN_API_TOKEN=

# Carpeta para subscribers.json, payments.json y signals_history.json
DATA_DIR=./data

# =============================================
# MONETIZACIÓN (Telegram Stars)
# =============================================
# Precio de Premium en Stars (≈ US$0.013 netos por Star para ti)
PREMIUM_PRICE_STARS=500
# 30 = suscripción mensual con renovación automática (Telegram solo permite 30 días)
PREMIUM_DAYS=30
TRIAL_DAYS=3
REFERRAL_BONUS_DAYS=7
# Horas de retraso con que los usuarios Free reciben la señal completa
FREE_SIGNAL_DELAY_HOURS=24
# true: cualquiera que inicie el bot queda autorizado como Free
TELEGRAM_AUTO_AUTHORIZE=true
# Contacto para /paysupport y /terms (obligatorio en bots con pagos)
PAYSUPPORT_CONTACT=@tu_usuario
