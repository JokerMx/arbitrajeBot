# =============================================
# CONFIGURACIÓN DE BASE DE DATOS
# =============================================
DATABASE_URL=mariadb://user:password@host:3306/database
DB_TABLE_PREFIX=BOT_

# ==========================================
# CLAVES Y CONEXIÓN
# ==========================================
PRIVATE_KEY=your_private_key_hex_here
WALLET=0xyour_wallet_address_here
NETWORK=testnet
LOG_LEVEL=info
VITE_BACKEND_PROTOCOL=http
VITE_BACKEND_HOST=localhost
VITE_BACKEND_PORT=3001

# =============================================
# CAPITAL INICIAL (se persistirá en BD)
# =============================================
INITIAL_CAPITAL=50.00

# =============================================
# ESTRATEGIA (se persistirá en BD)
# =============================================
STRATEGY_BASE_SPREAD_TICKS=8
STRATEGY_RISK_AVERSION=0.25
STRATEGY_MARKET_IMPACT=0.02
STRATEGY_INVENTORY_SKEW_STRENGTH=0.2
STRATEGY_VOLATILITY_LOOKBACK_MINUTES=20
STRATEGY_ORDER_REFRESH_MS=30000
STRATEGY_MAX_INVENTORY_RATIO=0.15

# =============================================
# RIESGO (en porcentajes)
# =============================================
RISK_MAX_POSITION_SIZE_PCT=0.15      # 15% del capital actual
RISK_MAX_DAILY_LOSS_PCT=0.30         # 30% del capital inicial
RISK_MAX_DRAWDOWN_PCT=0.20
RISK_KILL_SWITCH_ENABLED=true
RISK_CIRCUIT_BREAKER_THRESHOLD=0.03

# =============================================
# MERCADOS (se persistirá en BD)
# =============================================
MARKETS_ENABLED_BTC=true
MARKETS_MARGIN_ALLOC_BTC=0.12
MARKETS_MIN_SIZE_BTC=0.00001

MARKETS_ENABLED_ETH=true
MARKETS_MARGIN_ALLOC_ETH=0.12
MARKETS_MIN_SIZE_ETH=0.0001

MARKETS_ENABLED_BNB=true
MARKETS_MARGIN_ALLOC_BNB=0.12
MARKETS_MIN_SIZE_BNB=0.001

MARKETS_ENABLED_SOL=true
MARKETS_MARGIN_ALLOC_SOL=0.12
MARKETS_MIN_SIZE_SOL=0.01

MARKETS_ENABLED_XRP=true
MARKETS_MARGIN_ALLOC_XRP=0.12
MARKETS_MIN_SIZE_XRP=0.5

# =============================================
# TELEGRAM (se persistirá en BD)
# =============================================
TELEGRAM_ENABLED=true
TELEGRAM_NOTIFY_ORDERS=false
TELEGRAM_NOTIFY_FILLS=true
TELEGRAM_NOTIFY_STATUS=false
TELEGRAM_STATUS_INTERVAL=7200  # Cada 2 horas (7200 segundos)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
